[Unit]
Description=Network Configuration Processor
Documentation=file:///var/lib/network-staging/README.md
After=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/custom_scripts/process-network-configs
User=root
Group=root

# Basic security hardening
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

# File system access - allow what's needed
ReadWritePaths=/var/lib/network-staging /etc/NetworkManager/system-connections

[Install]
WantedBy=multi-user.target
